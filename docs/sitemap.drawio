        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam componentStyle rectangle\nskinparam shadowing false\n\ntitle Карта сайта: Портал «Мой Не Сам»\n\npackage \&quot;Зона «Гость»\&quot; {\n  [index.php\\n(Главная)] as index\n  [register.php\\n(Регистрация)] as register\n  [login.php\\n(Вход)] as login\n}\n\npackage \&quot;Зона «Клиент»\&quot; {\n  [orders.php\\n(Мои заявки)] as orders\n  [order_new.php\\n(Новая заявка)] as order_new\n}\n\npackage \&quot;Зона «Админ»\&quot; {\n  [admin.php\\n(Админ-панель)] as admin\n}\n\nnode \&quot;Действия без интерфейса\&quot; {\n  [logout.php\\n(Выход)] as logout\n}\n\n&#39; Переходы\nindex --&gt; login : \&quot;Кнопка Войти\&quot;\nindex --&gt; register : \&quot;Кнопка Регистрация\&quot;\n\nregister --&gt; login : \&quot;Успешная регистрация\&quot;\nlogin --&gt; orders : \&quot;Вход как Клиент\&quot;\nlogin --&gt; admin : \&quot;Вход как Админ\&quot;\n\norders --&gt; order_new : \&quot;Кнопка Новая заявка\&quot;\norder_new --&gt; orders : \&quot;Заявка создана\&quot;\n\norders --&gt; logout : \&quot;Кнопка Выйти\&quot;\nadmin --&gt; logout : \&quot;Кнопка Выйти\&quot;\n\nlogout ..&gt; index : \&quot;Редирект\&quot;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BjuFsR5jy3FTLI-2VIHp-1">
